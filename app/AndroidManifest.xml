<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.overlaydimmer"
    android:versionCode="8"
    android:versionName="1.1.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Phone remote: local HTTP server, only when enabled by the user. No outgoing connections. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Overlay Dimmer"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Controllable only by this app and from adb shell / root (shell holds DUMP), not by other apps. -->
        <service
            android:name=".DimService"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Boot broadcasts are delivered one app at a time; the highest priority gets it first. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
