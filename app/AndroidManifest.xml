<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.midnightbeam"
    android:versionCode="22"
    android:versionName="1.6.7">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Phone remote: local HTTP server, only when enabled by the user. No outgoing connections. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Finding the TVs on the local network (mDNS) from the phone app, like the WLED app does. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Optional, only if granted with adb (pm grant): lets the Enable button turn on the accessibility service
         by itself instead of sending the person to the Accessibility settings. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Optional, only if granted with adb (pm grant): lets the audio effects follow players that do not announce their
         audio session, by reading which sessions are playing from the audio service. -->
    <uses-permission android:name="android.permission.DUMP" />

    <!-- Optional audio effects (equalizer, bass, virtualizer, loudness) on the output mix, where the device supports them. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="MidnightBeam"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone/tablet screen: the remote page in a WebView. Also opens TV pairing links (the TV's QR code). -->
        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="midnightbeam" android:host="add" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:port="8765" />
            </intent-filter>
        </activity>

        <!-- Controllable only by this app and from adb shell / root (shell holds DUMP), not by other apps. -->
        <service
            android:name=".DimService"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Optional: lets the overlay be drawn as an accessibility overlay (full darkness, no touch blocking). -->
        <service
            android:name=".DimAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Boot broadcasts are delivered one app at a time; the highest priority gets it first. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
